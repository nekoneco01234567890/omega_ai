import json
import sqlite3


class EffectStore:
    def __init__(self, path: str = "runtime_state.db"):
        self.conn = sqlite3.connect(path, timeout=5.0)

        self.conn.execute(
            """
            CREATE TABLE IF NOT EXISTS effects (
                effect_id TEXT PRIMARY KEY,
                status TEXT NOT NULL,
                effect_json TEXT
            )
            """
        )

        # 既存DBとの互換性
        columns = {
            row[1]
            for row in self.conn.execute(
                "PRAGMA table_info(effects)"
            ).fetchall()
        }

        if "effect_json" not in columns:
            self.conn.execute(
                "ALTER TABLE effects ADD COLUMN effect_json TEXT"
            )

        self.conn.commit()

    def get_status(self, effect_id: str):
        row = self.conn.execute(
            """
            SELECT status
            FROM effects
            WHERE effect_id = ?
            """,
            (effect_id,),
        ).fetchone()

        return None if row is None else row[0]

    def set_status(self, effect_id: str, status: str):
        self.conn.execute(
            """
            INSERT INTO effects(
                effect_id,
                status,
                effect_json
            )
            VALUES (?, ?, NULL)
            ON CONFLICT(effect_id)
            DO UPDATE SET status = excluded.status
            """,
            (effect_id, status),
        )
        self.conn.commit()

    def save_effect(self, effect: dict):
        effect_id = effect["effect_id"]

        self.conn.execute(
            """
            INSERT INTO effects(
                effect_id,
                status,
                effect_json
            )
            VALUES (?, 'PENDING', ?)
            ON CONFLICT(effect_id)
            DO UPDATE SET effect_json = excluded.effect_json
            """,
            (
                effect_id,
                json.dumps(
                    effect,
                    ensure_ascii=False,
                    sort_keys=True,
                ),
            ),
        )

        self.conn.commit()

    def get_effect(self, effect_id: str):
        row = self.conn.execute(
            """
            SELECT effect_json
            FROM effects
            WHERE effect_id = ?
            """,
            (effect_id,),
        ).fetchone()

        if row is None or row[0] is None:
            return None

        return json.loads(row[0])

    def claim_execution(self, effect_id: str) -> bool:
        cursor = self.conn.execute(
            """
            INSERT INTO effects(
                effect_id,
                status,
                effect_json
            )
            VALUES (?, 'PENDING', NULL)
            ON CONFLICT(effect_id) DO NOTHING
            """,
            (effect_id,),
        )
        self.conn.commit()

        if cursor.rowcount == 1:
            return True

        cursor = self.conn.execute(
            """
            UPDATE effects
            SET status = 'PENDING'
            WHERE effect_id = ?
              AND status = 'FAILED'
            """,
            (effect_id,),
        )
        self.conn.commit()

        return cursor.rowcount == 1

    def close(self):
        self.conn.close()
